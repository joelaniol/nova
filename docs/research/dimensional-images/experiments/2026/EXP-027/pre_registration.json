{
  "schema_version": "1.0",
  "experiment_id": "EXP-027",
  "title": "Atomic Visual Temporal Understanding Benchmark",
  "status": "PREREGISTRATION_DRAFT",
  "research_type": "controlled_guided_design_blind_evaluation",
  "research_lead": "Joel Aniol",
  "registration": {
    "created_utc": null,
    "frozen_utc": null,
    "frozen_git_commit": null,
    "protocol_sha256": null,
    "modification_policy": "Any change after freeze requires a dated amendment. Original protocol remains preserved."
  },
  "research_questions": [
    "Can E3-K12 preserve observable motion direction?",
    "Can E3-K12 preserve partial and full occlusion events?",
    "Can a VLM infer reappearance after full occlusion?",
    "Can a VLM detect a reversal of motion?",
    "Can a VLM detect a short luminance transient?",
    "How does VLT compare with conventional frame sampling?"
  ],
  "study_scope": {
    "phase": "pilot",
    "initial_source": "deterministic_simulation",
    "clip_count": 5,
    "unit_of_analysis": "source_clip",
    "generalization_claims_permitted": false,
    "future_sources": [
      "real_camera",
      "ai_generated_video"
    ]
  },
  "video_specification": {
    "duration_seconds": 4.0,
    "native_fps_target": 60,
    "native_frame_count_target": 240,
    "native_resolution": "fixed_across_clips",
    "camera": "static",
    "lighting": "constant",
    "cuts_allowed": false,
    "moving_objects": 1,
    "object_type": "sphere",
    "obstacle_type": "stationary_block",
    "background": "static_dark",
    "motion_blur": "disabled_or_fixed",
    "audio_evaluated": false
  },
  "ingestion": {
    "sampling_method": "timestamp_based",
    "target_frame_count": 64,
    "target_fps": 16.0,
    "sample_timestamps_seconds": {
      "formula": "t_n = n / 16",
      "first": 0.0,
      "last": 3.9375,
      "n_range": [
        0,
        63
      ]
    },
    "spatial_resolution": [
      64,
      64
    ],
    "spatial_resize_method": "fixed_before_evaluation",
    "temporal_interpolation": "disabled",
    "timestamp_source": "decoded_presentation_timestamps",
    "required_checks": [
      "actual_duration",
      "frame_count",
      "monotonic_timestamps",
      "frame_decode_success",
      "source_sha256",
      "resampled_tensor_sha256"
    ],
    "nonconforming_clip_policy": "exclude_before_model_evaluation_and_document_reason"
  },
  "encoder": {
    "name": "E3-K12",
    "reference_implementation": "scripts/reference_carrier_codec.py",
    "source_commit": null,
    "source_sha256": null,
    "freeze_before_evaluation": true,
    "n_frames": 64,
    "k_modes": 12,
    "time_window_seconds": 4.0,
    "effective_fps": 16.0,
    "carrier_resolution": [
      128,
      128
    ],
    "normalization_divisor": 35.0,
    "mode_gain_low_order": 90.0,
    "mode_gain_high_order": 80.0,
    "dynamic_parameter_tuning_allowed": false,
    "native_temporal_chrominance_enabled": false
  },
  "experimental_conditions": [
    {
      "condition_id": "VLT_WEBP",
      "input_type": "e3_k12_carrier",
      "resolution": [
        128,
        128
      ],
      "format": "WEBP",
      "quality": 80,
      "input_frames": 64,
      "presentation": "single_carrier",
      "carrier_explanation": "fixed_nonsemantic_format_specification"
    },
    {
      "condition_id": "GRID128_WEBP",
      "input_type": "uniform_frame_contact_sheet",
      "resolution": [
        128,
        128
      ],
      "format": "WEBP",
      "quality": 80,
      "source_frame_indices": [
        0,
        4,
        8,
        12,
        16,
        20,
        24,
        28,
        32,
        36,
        40,
        44,
        48,
        52,
        56,
        60
      ],
      "layout": [
        4,
        4
      ],
      "presentation": "chronological_row_major"
    },
    {
      "condition_id": "GRID512_WEBP",
      "input_type": "uniform_frame_contact_sheet",
      "resolution": [
        512,
        512
      ],
      "format": "WEBP",
      "quality": 80,
      "source_frame_indices": [
        0,
        4,
        8,
        12,
        16,
        20,
        24,
        28,
        32,
        36,
        40,
        44,
        48,
        52,
        56,
        60
      ],
      "layout": [
        4,
        4
      ],
      "presentation": "chronological_row_major",
      "role": "higher_resolution_reference"
    }
  ],
  "clips": [
    {
      "clip_id": "C1",
      "name": "Visible Baseline Pass",
      "render_instruction": "Sphere moves left to right on a fully visible path without occlusion.",
      "ground_truth": {
        "moving_object_count": 1,
        "object_type": "sphere",
        "initial_direction": "left_to_right",
        "final_direction": "left_to_right",
        "speed_profile": "constant",
        "reversal_present": false,
        "occlusion_type": "none",
        "full_occlusion_present": false,
        "visibility_restored": false,
        "reemergence_after_full_occlusion": false,
        "brightness_pulse_present": false,
        "brightness_pulse_count": 0
      }
    },
    {
      "clip_id": "C2",
      "name": "Partial Occlusion",
      "render_instruction": "Sphere moves left to right and is partially hidden by the block, but never becomes fully invisible.",
      "render_constraints": {
        "minimum_visible_fraction_during_occlusion": 0.2,
        "maximum_visible_fraction_during_occlusion": 0.3
      },
      "ground_truth": {
        "moving_object_count": 1,
        "object_type": "sphere",
        "initial_direction": "left_to_right",
        "final_direction": "left_to_right",
        "speed_profile": "constant",
        "reversal_present": false,
        "occlusion_type": "partial",
        "full_occlusion_present": false,
        "visibility_restored": true,
        "reemergence_after_full_occlusion": false,
        "brightness_pulse_present": false,
        "brightness_pulse_count": 0
      }
    },
    {
      "clip_id": "C3",
      "name": "Full Occlusion and Reappearance",
      "render_instruction": "Sphere moves left to right, becomes fully invisible behind the block, then reappears on the right.",
      "render_constraints": {
        "full_occlusion_duration_min_seconds": 0.4,
        "full_occlusion_duration_max_seconds": 0.8,
        "reappearance_must_be_visible": true
      },
      "ground_truth": {
        "moving_object_count": 1,
        "object_type": "sphere",
        "initial_direction": "left_to_right",
        "final_direction": "left_to_right",
        "speed_profile": "constant",
        "reversal_present": false,
        "occlusion_type": "full",
        "full_occlusion_present": true,
        "visibility_restored": true,
        "reemergence_after_full_occlusion": true,
        "reemergence_side": "right",
        "brightness_pulse_present": false,
        "brightness_pulse_count": 0
      }
    },
    {
      "clip_id": "C4",
      "name": "Motion Reversal",
      "render_instruction": "Sphere approaches the block from the left, reverses direction once, and moves back left without passing behind the block.",
      "render_constraints": {
        "reversal_target_time_seconds": 2.0,
        "reversal_time_tolerance_seconds": 0.2,
        "contact_with_block_required": false
      },
      "ground_truth": {
        "moving_object_count": 1,
        "object_type": "sphere",
        "initial_direction": "left_to_right",
        "final_direction": "right_to_left",
        "speed_profile": "reversal",
        "reversal_present": true,
        "reversal_count": 1,
        "occlusion_type": "none",
        "full_occlusion_present": false,
        "visibility_restored": false,
        "reemergence_after_full_occlusion": false,
        "brightness_pulse_present": false,
        "brightness_pulse_count": 0
      }
    },
    {
      "clip_id": "C5",
      "name": "Full Occlusion with Brightness Pulse",
      "render_instruction": "Repeat C3 motion and occlusion, then apply one short luminance pulse after the sphere has reappeared.",
      "render_constraints": {
        "motion_path_matches": "C3",
        "pulse_target_start_seconds": 2.65,
        "pulse_duration_seconds": 0.25,
        "pulse_must_be_visible_after_reappearance": true,
        "native_chroma_only_pulse": false
      },
      "ground_truth": {
        "moving_object_count": 1,
        "object_type": "sphere",
        "initial_direction": "left_to_right",
        "final_direction": "left_to_right",
        "speed_profile": "constant",
        "reversal_present": false,
        "occlusion_type": "full",
        "full_occlusion_present": true,
        "visibility_restored": true,
        "reemergence_after_full_occlusion": true,
        "reemergence_side": "right",
        "brightness_pulse_present": true,
        "brightness_pulse_count": 1,
        "brightness_pulse_start_seconds": 2.65,
        "brightness_pulse_end_seconds": 2.9,
        "event_order": [
          "approach",
          "full_occlusion",
          "reemergence",
          "brightness_pulse"
        ]
      }
    }
  ],
  "ground_truth_procedure": {
    "status": "planned_expectations_pending_render_qc",
    "verify_against_rendered_video": true,
    "record_actual_event_timestamps": true,
    "record_object_visibility_per_frame": true,
    "freeze_verified_ground_truth_before_evaluation": true,
    "nonconforming_video_policy": "exclude_or_amend_before_evaluator_exposure",
    "evaluator_access_to_ground_truth": false
  },
  "blind_evaluation": {
    "blinding_level": "content_blind",
    "stimulus_filenames": "random_uuid",
    "randomization": "seeded_and_logged",
    "random_seed": null,
    "show_clip_ids_to_evaluator": false,
    "show_condition_ids_to_evaluator": false,
    "show_ground_truth_to_evaluator": false,
    "allow_filesystem_browsing": false,
    "allow_unrestricted_web_access": false,
    "neutral_prompt": "Beschreibe ausschlie\u00dflich, was du in der dargestellten Szene erkennen kannst, in zeitlicher Reihenfolge. Kennzeichne Unsicherheiten ausdr\u00fccklich. Erfinde keine nicht sichtbaren Ereignisse.",
    "format_instructions": {
      "VLT_WEBP": "fixed_codec_explanation_without_event_labels",
      "GRID128_WEBP": "fixed_chronological_grid_explanation",
      "GRID512_WEBP": "fixed_chronological_grid_explanation"
    },
    "format_prompts_must_be_frozen": true,
    "response_format": "free_text",
    "independent_evaluations_per_clip_per_condition": 3,
    "model_provider": null,
    "model_id": null,
    "model_snapshot": null,
    "temperature": null,
    "evaluation_timestamp_utc": null,
    "record_full_prompts_and_responses": true
  },
  "scoring": {
    "freeze_before_first_model_run": true,
    "ground_truth_visibility": "scoring_stage_only",
    "annotation_procedure": "blind_response_coding_before_ground_truth_comparison",
    "unknown_or_unresolved_response": "abstention",
    "unsupported_positive_claim": "false_positive",
    "primary_endpoints": [
      {
        "name": "motion_direction_accuracy",
        "metric": "exact_category_match"
      },
      {
        "name": "occlusion_class_accuracy",
        "metric": "exact_category_match",
        "labels": [
          "none",
          "partial",
          "full"
        ]
      },
      {
        "name": "reversal_detection",
        "metric": "binary_confusion_matrix"
      },
      {
        "name": "full_occlusion_reemergence_detection",
        "metric": "binary_confusion_matrix"
      },
      {
        "name": "brightness_pulse_detection",
        "metric": "binary_confusion_matrix"
      }
    ],
    "secondary_endpoints": [
      "event_order_accuracy",
      "object_type_accuracy",
      "hallucinated_event_count",
      "abstention_rate",
      "response_consistency_across_runs"
    ],
    "timing_tolerance_seconds": 0.2,
    "report_per_clip_results": true,
    "report_confusion_matrices": true,
    "report_sample_sizes": true,
    "statistical_scope": "descriptive_pilot_no_general_population_claims"
  },
  "resource_accounting": {
    "record_input_image_bytes": true,
    "record_metadata_bytes": true,
    "record_prompt_tokens": true,
    "record_billed_image_tokens_if_available": true,
    "record_response_tokens": true,
    "record_latency_ms": true,
    "record_cost_if_available": true,
    "compare_png_and_webp_bytes_separately": true,
    "pixel_matched_comparison": [
      "VLT_WEBP",
      "GRID128_WEBP"
    ],
    "higher_detail_comparison": [
      "VLT_WEBP",
      "GRID512_WEBP"
    ],
    "forbid_unmeasured_token_savings_claims": true
  },
  "artifact_policy": {
    "original_videos_sha256_required": true,
    "resampled_frames_sha256_required": true,
    "carrier_sha256_required": true,
    "control_images_sha256_required": true,
    "preserve_unmodified_originals": true,
    "preserve_prompt_versions": true,
    "preserve_raw_model_responses": true,
    "evaluator_receives_only_sanitized_stimuli": true
  },
  "success_policy": {
    "do_not_assume_vlt_superiority": true,
    "all_negative_results_reported": true,
    "all_protocol_deviations_reported": true,
    "experiment_success_means_valid_measurement_not_high_accuracy": true
  }
